# --- LLM providers (leave ALL empty to run in deterministic template-only mode) ---
# OpenRouter is the recommended path: one key, many models (incl. free tiers).
OPENROUTER_API_KEY=
LLM_OPENROUTER_MODEL=minimax/minimax-m3:free
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_PRIMARY_MODEL=claude-sonnet-4-5
LLM_SECONDARY_MODEL=gpt-4o-mini

# --- team identity (GET /v1/metadata) ---
TEAM_NAME=Team Sutra
TEAM_MEMBERS=Member 1, Member 2
CONTACT_EMAIL=team@example.com

# --- spend guardrails (Rules C-01..C-04) ---
SPEND_SOFT_USD=20
SPEND_HARD_USD=25

# --- ops ---
SNAPSHOT_PATH=data/snapshot.json
SNAPSHOT_INTERVAL_S=30
DISABLE_LLM=0

# --- budgets ---
MAX_ACTIONS_PER_TICK=20
TOP_K_PER_TICK=5
TICK_DEADLINE_S=24

# --- artifact jsonl logs (TechSpec §12) ---
ARTIFACTS_DIR=data/artifacts
